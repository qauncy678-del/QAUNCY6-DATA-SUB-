# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# First-boot admin account (created automatically if it doesn't exist)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@quancy6.app
ADMIN_PASSWORD=change-this-password
ADMIN_PHONE=08000000000

# Data delivery provider: "mock" (default, no real data is sent) or "vtpass"
DATA_PROVIDER=mock

# Only needed when DATA_PROVIDER=vtpass
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
